# Environment
ENV=development

# Postgres
# For host-local runs use localhost. Docker Compose overrides this to the
# postgres service hostname for the backend container.
POSTGRES_PORT=15432
DATABASE_URL=postgresql://pipeline:pipeline@localhost:15432/pipeline

# OpenClaw
OPENCLAW_API_URL=http://localhost:11434
OPENCLAW_API_KEY=
OPENCLAW_MODEL=qwen2.5-coder:32b
OPENCLAW_TIMEOUT=300

# OpenCode
OPENCODE_API_URL=http://localhost:14096
OPENCODE_PORT=14096
OPENCODE_SERVER_PASSWORD=
OPENCODE_TIMEOUT=600
OPENCODE_BUSY_STABLE_SECONDS=120
OPENCODE_STUCK_TIMEOUT_SECONDS=600
OPENCODE_WORKSPACE_ROOT=/workspaces

# GitHub
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_REPO_PRIVATE=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=
TELEGRAM_ESCALATION_CHAT_ID=
TELEGRAM_NOTIFICATION_CHAT_ID=

# Webhook security
WEBHOOK_SECRET=change-me

# API
BACKEND_PORT=18000
BACKEND_API_URL=http://127.0.0.1:18000/api/v1

# Pipeline limits
MAX_REVIEW_RETRIES=3
MAX_TEST_RETRIES=3
MAX_LOCAL_SAME_FAILURE_RETRIES=3
MAX_CI_SAME_FAILURE_RETRIES=3
MAX_OPENCODE_STUCK_RETRIES=2
JOB_STALE_TIMEOUT=1800
CI_POLLING_TIMEOUT=600
CI_POLLING_GRACE_TIMEOUT=300
CI_POLLING_INTERVAL=15
WORKSPACE_ROOT=workspaces
NODE_TEST_CONTAINER_SERVICE=
NODE_TEST_DOCKER_COMPOSE_DIR=.
SMOKE_TEST_ENABLED=false
SMOKE_TEST_BROWSER_TIMEOUT_MS=30000
SMOKE_TEST_COMMAND_TIMEOUT=180
SMOKE_TEST_HEADLESS=true
